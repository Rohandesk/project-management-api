generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model projects {
  project_id   Int     @id @default(autoincrement())
  project_name String  @db.VarChar(50)
  user_id      Int?
  users        users?  @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  tasks        tasks[]
}

model tasks {
  task_id    Int       @id @default(autoincrement())
  task_name  String    @db.VarChar(50)
  status     String    @db.VarChar(20)
  project_id Int?
  projects   projects? @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  user_id    Int        @id @default(autoincrement())
  user_name  String     @db.VarChar(50)
  user_email String     @unique @db.VarChar(50)
  projects   projects[]

  @@index([user_email], map: "user_email_idx")
}
